# ===== Корсик: конфигурация (скопируйте в .env и заполните). .env в Git не кладётся.
POSTGRES_PASSWORD=CHANGE_ME_long_random
# Для запуска без Docker: DATABASE_URL=postgresql://korsik:ПАРОЛЬ@127.0.0.1:5432/korsik

# --- MAX
# max | console (локальная проверка без MAX)
TRANSPORT=max
MAX_BOT_TOKEN=CHANGE_ME
MAX_BOT_URL=https://max.ru/id5021013384_2_bot
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_WEBHOOK_SECRET=CHANGE_ME_5_to_256_chars_A-Za-z0-9_-
# MAX_CA_BUNDLE=certs/russian_trusted_root_ca.pem   # если ОС не доверяет сертификату API MAX

# --- Публичный HTTPS-адрес (туннель Cloudflare -> http://app:8000 или http://127.0.0.1:8000)
PUBLIC_BASE_URL=https://polyplastic.cc.cd
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# --- Локальная модель (Ollama на хосте)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=poliplastik-qwen:latest
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120
LLM_MAX_ANSWER_TOKENS=700
# пусто = только BM25
EMBED_MODEL=bge-m3
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # опционально, нужен sentence-transformers

# --- Кабинет и сценарий
HR_LOGIN=hr
# true, если кабинет открывают по HTTPS-домену; для http://127.0.0.1:8000 оставьте false
COOKIE_SECURE=false
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_SEND_TIME=10:00
REMINDER_TIME=10:00
STALE_HOURS=24
# 0 = понедельник
DIGEST_WEEKDAY=0
DIGEST_TIME=09:00

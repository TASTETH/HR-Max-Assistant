# Ingestion is unchanged. Point to its OUTPUT directory containing current.json.
RAG_INGESTION_OUTPUT=data/ingested
RAG_INDEX_DIR=data/rag
RAG_SCOPE_FILE=document_scope.json

# Generate two independent secrets; keep them only on backend/server.
QDRANT_API_KEY=
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=${QDRANT_API_KEY}
RAG_QDRANT_TIMEOUT=15
RAG_HTTP_TRUST_ENV=false
RAG_SERVICE_TOKEN=

RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_MODEL_CACHE=data/models
RAG_OFFLINE=false
RAG_DEVICE=cpu
RAG_BATCH_SIZE=2
RAG_TORCH_THREADS=2
RAG_EMBEDDING_MAX_TOKENS=1024
RAG_RERANKER_MAX_TOKENS=1024
RAG_QUERY_MAX_TOKENS=256

RAG_DENSE_TOP_K=20
RAG_BM25_TOP_K=20
RAG_RERANK_TOP_N=12
RAG_CONTEXT_TOP_K=5
RAG_RRF_K=60
RAG_CONTEXT_MAX_CHARS=16000
RAG_CONTEXT_MAX_TOKENS=6500
RAG_RULE_MAX_CHARS=18000

# OpenAI-compatible chat completions base URL, e.g. http://127.0.0.1:8000/v1
# Empty values mean generation is not configured; ask returns service_error.
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_LLM_TIMEOUT=90
RAG_LLM_MAX_TOKENS=1200
RAG_LLM_INPUT_MAX_TOKENS=16000
# Enable only if your LLM server supports response_format=json_object.
RAG_LLM_JSON_MODE=false
# Recommended: local/HF tokenizer of the actual LLM, with pinned revision.
# Without it a conservative UTF-8 byte budget is used, with no truncation.
RAG_LLM_TOKENIZER=
RAG_LLM_TOKENIZER_REVISION=

# Optional server default for a deployment serving ONE verified organization.
# polyplastic_group_llc is the named ООО «Группа ПОЛИПЛАСТИК», not all subsidiaries.
# Leave empty when backend provides each employee's trusted context.
RAG_SERVER_ORG_ID=
RAG_SERVER_SITE_ID=
RAG_SERVER_PERMISSIONS=kb:read
RAG_ADDRESS_STYLE=вы
RAG_QUEUE_TIMEOUT=5
RAG_HISTORY_MESSAGES=4
RAG_HISTORY_MAX_CHARS=3000

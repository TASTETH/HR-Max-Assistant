# Пример конфигурации ОБЩЕГО backend. Модуль сам .env не читает.
# Замените адреса и CHANGE_ME. Файл с настоящими значениями: .env (не в Git).
DATABASE_URL=postgresql+psycopg://korsik_app:CHANGE_ME@127.0.0.1:5432/korsik
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Конечный сетевой timeout настраивается в MAX-адаптере команды.
# Он должен быть меньше двухминутной аренды задачи в общей БД.
MAX_SEND_TIMEOUT_SECONDS=20

# Шаблон без секретов. python -m app.configure создаёт локальный .env
# со случайными паролями и секретом webhook. Затем заполните токен своего бота.
MAX_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
MAX_BOT_URL=https://max.ru/id5021013384_2_bot
MAX_WEBHOOK_SECRET=replace_with_random_urlsafe_secret
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_CA_BUNDLE=certs/russian_trusted_root_ca.pem
# Постоянный HTTPS origin; при временном туннеле скрипт заполнит автоматически.
PUBLIC_BASE_URL=

# Для docker compose. Используйте разные случайные пароли без спецсимволов URL.
POSTGRES_DB=korsik
POSTGRES_USER=korsik_admin
POSTGRES_PASSWORD=replace_with_random_admin_password
DATABASE_APP_PASSWORD=replace_with_random_app_password

# Пароль korsik_app должен совпадать с DATABASE_APP_PASSWORD.
DATABASE_URL=postgresql://korsik_app:replace_with_random_app_password@127.0.0.1:55432/korsik
DATABASE_ADMIN_URL=postgresql://korsik_local_admin:replace_with_random_local_admin_password@127.0.0.1:55432/korsik
# Для независимого onboarding, если вызывающий backend использует SQLAlchemy.
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://korsik_app:replace_with_random_app_password@127.0.0.1:55432/korsik
LOCAL_WORKER_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
# Совместимость с конфигурацией отдельного onboarding-модуля.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
MAX_SEND_TIMEOUT_SECONDS=20

OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_THINK=
ROUTER_INTENT_MODEL=
# Пусто = локальный RAG: PostgreSQL, выдержки и источники.
RAG_URL=
# Необязательные проверенные реквизиты закреплённого HR; применяются командой seed.
HR_MAX_CHAT_ID=
HR_CONTACT_URL=

# Совместимый HTTP RAG для независимого Router; при пустом значении используется RAG_URL.
ROUTER_RAG_URL=

# Необязательный постоянный Cloudflare Tunnel. Настоящий токен хранится только локально.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
